#include <stdio.h>
#include <math.h>

#define N 3       // Количество уравнений
#define EPS 1e-6  // Точность
#define MAX_ITER 1000  // Максимальное количество итераций

// Функция для метода простых итераций
void simpleIteration(double a[N][N], double b[N], double x[N]) {
    double x_new[N];
    int iter = 0;
    double norm;
    do {
        for (int i = 0; i < N; i++) {
            x_new[i] = b[i];
            for (int j = 0; j < N; j++) {
                if (i != j) {
                    x_new[i] -= a[i][j] * x[j];
                }
            }
            x_new[i] /= a[i][i];
        }
        // Вычисляем норму разности
        norm = 0.0;
        for (int i = 0; i < N; i++) {
            norm += fabs(x_new[i] - x[i]);
        }

        // Обновляем x
        for (int i = 0; i < N; i++) {
            x[i] = x_new[i];
        }

        iter++;
    } while (norm > EPS && iter < MAX_ITER);

    printf("metod prostih iteraciy:\n");
    printf("kolichestvo iteraciy: %d\n", iter);
    printf("reshenie: x1 = %.6f, x2 = %.6f, x3 = %.6f\n", x[0], x[1], x[2]);
}

// Функция для метода Зейделя
void seidelMethod(double a[N][N], double b[N], double x[N]) {
    double x_new[N];
    int iter = 0;
    double norm;

    do {
        for (int i = 0; i < N; i++) {
            x_new[i] = b[i];
            for (int j = 0; j < N; j++) {
                if (i != j) {
                    x_new[i] -= a[i][j] * (i < j ? x[j] : x_new[j]);
                }
            }
            x_new[i] /= a[i][i];
        }
        // Вычисляем норму разности
        norm = 0.0;
        for (int i = 0; i < N; i++) {
            norm += fabs(x_new[i] - x[i]);
        }

        // Обновляем x
        for (int i = 0; i < N; i++) {
            x[i] = x_new[i];
        }

        iter++;
    } while (norm > EPS && iter < MAX_ITER);

    printf("\nmetod zeydelya:\n");
    printf("kolichestvo iteraciy: %d\n", iter);
    printf("reahenie: x1 = %.6f, x2 = %.6f, x3 = %.6f\n", x[0], x[1], x[2]);
}

int main() {
    // Матрица коэффициентов
    double a[N][N] = {
        {0.10, -0.04, -0.13},
        {-0.04, 0.34, 0.05},
        {-0.13, 0.05, 0.63}
    };

    // Правая часть после равно
    double b[N] = {-0.15, 0.31, 0.37};

    // Начальное приближение
    double x[N] = {0.0, 0.0, 0.0};

    // Решение методом простых итераций
    simpleIteration(a, b, x);

    // Обнуляем начальное приближение для метода Зейделя
    for (int i = 0; i < N; i++) {
        x[i] = 0.0;
    }

    // Решение методом Зейделя
    seidelMethod(a, b, x);

    return 0;
}
