#include <stdio.h>
#include <conio.h>
#include <string.h>
#include <stdlib.h>

struct chitatel
{
    char fam[50];
    char name[50];
    char otch[50];
    char book_name[50];
    char srok_sdachi[20];
};

struct chitatel* chitatels = NULL;
int chitatel_count = 0;
int chitatel_emkost = 0;

void input();
void sort();
void search();
void delete_chitatel();
void output();
void save_to_file();
void read_file();
int main()
{
    int choice;

    do
    {
        printf("\n===== menu =====\n");
        printf("1. vvod chitatel\n");
        printf("2. sort po fam\n");
        printf("3. search po fam\n");
        printf("4. delete chitatel\n");
        printf("5. pokaz chitatel v console\n");
        printf("6. vivod v fail chitatel\n");
        printf("8. read faile\n");
        printf("vash vibor: ");
        scanf("%d", &choice);
        getchar();

        switch (choice)
        {
        case 1: input();break;
        case 2: sort(); break;
        case 3: search(); break;
        case 4: delete_chitatel(); break;
        case 5: output();break;
        case 6: save_to_file();break;
        case 7: printf("Выход из программы.\n"); break;
        case 8: read_file();break;
        default: printf("Неверный пункт меню!\n");
        }

    } while (choice != 7);
       printf("Нажмите esc для выхода\n");
    int ch;
    do {
        ch = getchar();
    } while (ch != 27);
    free(chitatels);
    return 0;
}

void input()
{
    if (chitatel_count == chitatel_emkost)
    {
        int new_emkost = (chitatel_emkost == 0) ? 1 : chitatel_emkost * 2;
        struct chitatel* temp = realloc(chitatels, new_emkost * sizeof(struct chitatel));

        if (temp == NULL)
        {
            printf("Ошибка выделения памяти!\n");
            return;
        }

        chitatels = temp;
        chitatel_emkost = new_emkost;
    }

    printf("\nchitatel %d:\n", chitatel_count + 1);
    printf("vvod fam: ");
    gets(chitatels[chitatel_count].fam);
    printf("vvod name: ");
    gets( chitatels[chitatel_count].name);
    printf("vvedite otch: ");
    gets( chitatels[chitatel_count].otch);
    printf("book name vvod:");
    gets(chitatels[chitatel_count].book_name);
    printf("vvod srok sdachi: ");
    scanf("%s", chitatels[chitatel_count].srok_sdachi);
    getchar();
    chitatel_count++;
    printf("chitatel dobavlen!\n");
}

void output()
{
    if (chitatel_count == 0)
    {
        printf("spisok chitatekls!\n");
        return;
    }

    printf("\n===== spiso chitatel =====\n");

    for (int i = 0; i < chitatel_count; i++)
    {
        printf("\nchitatel №%d\n", i + 1);
        printf("fam: %s\n", chitatels[i].fam);
        printf("name: %s\n", chitatels[i].name);
        printf("imypobatky: %s\n", chitatels[i].otch);
        printf("book: %s\n", chitatels[i].book_name);
        printf("srok sdachi: %s\n", chitatels[i].srok_sdachi);
    }
}

void sort()
{
    if (chitatel_count == 0)
    {
        printf("Массив пуст! Нечего сортировать.\n");
        return;
    }
    struct chitatel temp1;
    for (int i = 0; i < chitatel_count - 1; i++)
    {
        for (int j = i + 1; j < chitatel_count; j++)   
        {
            if (strcmp(chitatels[i].fam, chitatels[j].fam) > 0)
            {
                temp1 = chitatels[i];
                chitatels[i] = chitatels[j];
                chitatels[j] = temp1;
            }
        }
    }
    printf("Массив отсортирован по фамилии.\n");
}

void search()
{
    if (chitatel_count == 0)
    {
        printf("Массив пуст!\n");
        return;
    }

    char target[50];
    printf("vvedite fam poisk: ");
    gets(target);  

    int found = 0;
    for (int i = 0; i < chitatel_count; i++)
    {
        if (strcmp(chitatels[i].fam, target) == 0)
        {
            printf("\nnaiden chitatel #%d:\n", i + 1);
            printf("fam: %s\n", chitatels[i].fam);
            printf("name: %s\n", chitatels[i].name);
            printf("otch: %s\n", chitatels[i].otch);
            printf("book: %s\n", chitatels[i].book_name);
            printf("srok sdachi: %s\n", chitatels[i].srok_sdachi);
            found = 1;
        }
    }

    if (!found)
        printf("chitatel s fam  '%s' ne naiden.\n", target);
}

void delete_chitatel()
{
    if (chitatel_count == 0)
    {
        printf("Массив пуст!\n");
        return;
    }

    char target[50];
    printf("vvedite fam chitatel dla delete: ");
    gets(target);   

    for (int i = 0; i < chitatel_count; i++)
    {
        if (strcmp(chitatels[i].fam, target) == 0)
        {
            for (int j = i; j < chitatel_count - 1; j++)
            {
                chitatels[j] = chitatels[j + 1];
            }
            chitatel_count--;
            printf("читатель с фамилией '%s' удалён.\n", target);
            return;
        }
    }

    printf("читатель с фамилией '%s' не найден.\n", target);
}

void save_to_file()
{
    if (chitatel_count == 0)
    {
        printf("Нет данных для сохранения в файл!\n");
        return;
    }

    FILE *f = fopen("vixod.dat", "wb");
    if (f == NULL)
    {
        perror("invalid zapisi");
        return;
    }

    //   записываем количество записей 
    if (fwrite(&chitatel_count, sizeof(int), 1, f) != 1)
    {
        printf("invalid zapisi!\n");
        fclose(f);
        return;
    }

    // записываем сами структуры 
    size_t written = fwrite(chitatels, sizeof(struct chitatel), chitatel_count, f);
    fclose(f);

    if (written != (size_t)chitatel_count)
    {
        printf("invalid zapisi!\n");
        return;
    }

    printf("dannie sohraneni v vixod.dat (%d zapisey)\n", chitatel_count);
}

void read_file()
{
    FILE *f = fopen("read.dat", "rb");
    if (f == NULL)
    {
        perror("invalid fail dlz chtenya ne otkrilsa");
        return;
    }

    int count = 0;


    if (fread(&count, sizeof(int), 1, f) != 1)
    {
        printf("invalid chtrniz zapisi!\n");
        fclose(f);
        return;
    }

    if (count <= 0)
    {
        printf("Файл пуст или повреждён (count=%d)\n", count);
        fclose(f);
        return;
    }

    // 2) отдельная память под count записей подогнать размер памяти точно под количество записей из файла
    struct chitatel *temp = (struct chitatel*)realloc(chitatels, count * sizeof(struct chitatel));
    if (temp == NULL)
    {
        printf("invalid pamyat!\n");
        fclose(f);
        return;
    }
    chitatels = temp;
    chitatel_emkost = count;

    // читаем массив структур 
    size_t readed = fread(chitatels, sizeof(struct chitatel), count, f);
    fclose(f);

    if (readed != (size_t)count)
    {
        printf("invalid dannix(prochitano %zu из %d)\n", readed, count);
        return;
    }

    chitatel_count = count;

    printf("prochitamo %d zapisey iz vixod.dat\n", chitatel_count);

    // раскомментировать: 
    output();
}
